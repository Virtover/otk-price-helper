{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OTK Price Helper",
  "version": "0.6.0",
  "identifier": "pl.otk.pricehelper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OTK Price Helper",
        "visible": false,
        "width": 1120,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Price setting helper",
    "longDescription": "Calculates price lists for every package, customer type and month combination, guaranteeing the minimum profit."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCNEUwNjk1MkUzMUJDOTYKUldTV3ZERXVsUVpPaTFFeFRhQzRQRUl4bkJaZDgvaFMwSWtaSSt3WHhZdmZlQjB3T1BsSkMwa1IK",
      "endpoints": [
        "https://github.com/Virtover/otk-price-helper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
